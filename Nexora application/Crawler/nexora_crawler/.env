# ── Playwright Settings ─────────────────────────────────────────────────
# NEXORA_PLAYWRIGHT_ENABLED controls both the DynamicDetectionMiddleware
# AND the Scrapy download handlers.
#
#   false (default): All requests use standard HTTP/1.1 (static crawl)
#   true:           Playwright + Chromium + stealth for JS-heavy/anti-bot sites
#
# IMPORTANT: scrapy-playwright 0.0.34 is incompatible with Scrapy 2.16's
# HTTP11DownloadHandler API. Keep 'false' for standard crawling.
# To use Playwright, upgrade: pip install scrapy-playwright>=0.0.40
# and ensure: playwright install chromium
NEXORA_PLAYWRIGHT_ENABLED=false
NEXORA_PLAYWRIGHT_HEADLESS=true
NEXORA_PLAYWRIGHT_MAX_PAGES=5
NEXORA_PLAYWRIGHT_TIMEOUT=30000
NEXORA_STEALTH_ENABLED=true
NEXORA_SITE_PROFILE_DB=./data/site_profiles.db
